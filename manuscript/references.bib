@article{zwarts_feeding_1994,
	title = {Feeding radius, burying depth and siphon size of \textit{{Macoma} balthica} and \textit{{Scrobicularia} plana}},
	volume = {183},
	issn = {0022-0981},
	url = {https://www.sciencedirect.com/science/article/pii/0022098194900876},
	doi = {10.1016/0022-0981(94)90087-6},
	abstract = {This paper investigates whether siphon weight limits the elongation of the siphon of deposit-feeding benthic bivalves under natural conditions. Were this to be so, it would imply that foraging and predator avoidance place conflicting demands on these animals, since an increase in the feeding radius on the surface would be associated with a decrease in the burying depth, and vice versa. The paper presents methods with which to measure siphon length and equations to transform siphon weight to siphon length in two benthic bivalves, Scrobicularia plana and Macoma balthica. Relatively heavy siphons are longer, but also thicker, than lightweight ones. We conclude that most individual bivalves stretch their siphons fully while feeding. However, bivalves with heavy siphons keep part of the siphon in reserve within the shell. Siphon cropping therefore results in an immediate reduction in siphon length, unless the siphon is heavy and a reserve is available. The feeding radius of M. balthica and S. plana is a linear function of shell size. S. plana use half of their siphon length to feed on the surface and the other half to bury themselves, but if the siphon weight is below average, the proportion extended over the surface decreases with siphon size. However, among the animals with a short siphon, those with a good body condition take no risks and live as deeply as possible. A comparison between species reveals that the weight of the extended inhalant siphon per cm amounts, on average, to 0.6\% of the total body weight.},
	number = {2},
	urldate = {2026-11-10},
	journal = {Journal of Experimental Marine Biology and Ecology},
	author = {Zwarts, Leo and Blomert, Anne-Marie and Spaak, Piet and de Vries, Bauke},
	month = nov,
	year = {1994},
	keywords = {Burying depth, Feeding radius, Macoma balthica, Scrobicularia plana, Siphon},
	pages = {193--212},
	file = {ScienceDirect Snapshot:C\:\\Users\\fmounier\\Zotero\\storage\\V6A5HHPH\\0022098194900876.html:text/html},
}



